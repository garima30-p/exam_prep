{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-11-21",
  "ai": { "binding": "AI" },
  "vars": { "STUDY_AI_ENABLED": "false" },
  "durable_objects": { "bindings": [{ "name": "STUDY_BUDGET", "class_name": "StudyBudget" }] },
  "migrations": [{ "tag": "study-budget-v1", "new_sqlite_classes": ["StudyBudget"] }],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  }
}
